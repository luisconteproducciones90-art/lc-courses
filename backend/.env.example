# ─── SERVER ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── DATABASE (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/lc_courses
# Railway: usa la variable DATABASE_URL que ellos proveen automáticamente

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=tu_secreto_super_largo_y_seguro_aqui_minimo_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d

# ─── MERCADO PAGO ─────────────────────────────────────────
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret_de_mp

# ─── CLOUDFLARE R2 ────────────────────────────────────────
R2_ACCOUNT_ID=tu_account_id_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET_NAME=lc-courses-videos
R2_PUBLIC_URL=https://tu-bucket.tu-dominio.com

# ─── EMAIL (Nodemailer) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=lccourses2026@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM="LC-COURSES <lccourses2026@gmail.com>"

# ─── GOOGLE AUTH ──────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ─── RATE LIMITING ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
