# Copiá a .env (NUNCA lo subas a Git).
NODE_ENV=production
PUBLIC_URL=https://ai.TU-DOMINIO-DEMOS.com       # el subdominio final, con https (lo usan CSRF, widget y webhooks)
DB_PASSWORD=cambiar-por-una-clave-larga
JWT_SECRET=                                       # openssl rand -hex 48
ENCRYPTION_KEY=                                   # openssl rand -hex 32  (cifra tokens de WhatsApp y secretos; NO la pierdas ni la cambies)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
AI_PROVIDER=mock                                  # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cobro online de suscripciones (opcional)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
EMBEDDINGS_PROVIDER=                              # local | openai (por defecto: openai si hay OPENAI_API_KEY)
