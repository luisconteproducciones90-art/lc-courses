# --- Servidor ---
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
# Orígenes extra permitidos (frontend en otro dominio), separados por coma
CORS_ORIGINS=

# --- Base de datos (rol NO superusuario, sin BYPASSRLS) ---
DATABASE_URL=postgres://lc_ai:lc_ai@localhost:5432/lc_ai_business
DATABASE_SSL=false

# --- Seguridad (obligatorio en producción; >= 32 caracteres aleatorios) ---
JWT_SECRET=

# --- Primer SUPER ADMIN (usado por `npm run seed`) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- IA (las claves viven SOLO aquí, nunca en el frontend) ---
AI_PROVIDER=mock          # mock | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Fases 3-4 ---
ENCRYPTION_KEY=           # obligatoria en producción (>= 32 caracteres)
MP_ACCESS_TOKEN=          # Mercado Pago (suscripciones)
MP_WEBHOOK_SECRET=
ALLOW_PRIVATE_URLS=       # solo desarrollo/tests: permite webhooks/conectores a 127.0.0.1
EMBEDDINGS_PROVIDER=       # local | openai (por defecto: openai si hay OPENAI_API_KEY)
OPENAI_EMBED_MODEL=text-embedding-3-small
REDIS_URL=                # opcional: rate limit compartido entre instancias
